# Copy this file to .env.local and fill in the values. .env.local is git-ignored and must never be committed.
# In production, add the same names under Vercel > Project Settings > Environment Variables.

# Met Office Weather DataHub, "Site Specific" API (free plan). https://datahub.metoffice.gov.uk
# Leave empty to use Open-Meteo, which needs no key.
MET_OFFICE_API_KEY=

# OpenRouteService, for real road drive times. https://openrouteservice.org/dev/#/signup
# Leave empty to use estimated drive times.
ORS_API_KEY=

# GitHub sign-in (Auth.js). Create an OAuth app at https://github.com/settings/developers
# Callback URL: http://localhost:4317/api/auth/callback/github (and your Vercel URL in production)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Who is allowed in. Comma-separated; either list is enough.
ALLOWED_GITHUB_USERS=
ALLOWED_EMAILS=

# Set to 1 to skip every live API and use generated demo forecasts.
USE_DEMO_DATA=
